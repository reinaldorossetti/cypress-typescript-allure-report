{
  "scripts": {
    "tests-chrome": "cypress run --env allure=true --env video=true --browser chrome",
    "tests-edge": "cypress run --env allure=true --env video=true --browser edge",
    "tests-firefox": "cypress run --env allure=true --env video=true --browser firefox",
    "test:shopping-cart": "cypress run --env allure=true --env video=true --browser chrome --spec \"cypress/e2e/features/shopping_cart/**/*.cy.ts\"",
    "test:vertem-cadastro": "cypress run --env allure=true --env video=true --browser chrome --spec \"cypress/e2e/features/vertem_cadastro/**/*.cy.ts\"",
    "test:shadow-dom": "cypress run --env allure=true --env video=true --browser chrome --spec \"cypress/e2e/features/shadow_dom/**/*.cy.ts\"",
    "open": "cypress open",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "dependencies": {
    "@shelex/cypress-allure-plugin": "^2.37.0",
    "cypress": "12.17.4",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3"
  }
}
